<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.session-inbox-tunnel</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>__HOME__/.cloudflared/session-inbox.yml</string>
    <string>--no-autoupdate</string>
    <string>run</string>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/session-inbox-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/session-inbox-tunnel.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
